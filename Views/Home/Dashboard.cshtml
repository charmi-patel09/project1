                const title = document.getElementById('habitSelectedDate');
                const list = document.getElementById('habitDayDetailsList');
                if (!list) return;

                const date = new Date(dateStr);
                title.innerText = `Habits for ${date.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' })}`;

                const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
                const dayName = dayNames[date.getDay()];

                const habitsForDay = habits.filter(h => {
                    const start = new Date(h.startDate);
                    start.setHours(0,0,0,0);
                    if (start > date) return false;
                    if (h.frequencyType === 'Custom' && h.customDays) {
