                    <div class="news-list" id="newsFeed"><div style="padding: 30px; text-align: center; opacity: 0.6;"><i class="fas fa-search" style="font-size: 2rem; margin-bottom: 10px;"></i><p>Search News</p></div></div>
                </section>
