            function renderHabitCalendar() {
                const grid = document.getElementById('habitCalendarGrid');
                if (!grid) return;

                const now = new Date();
                const year = now.getFullYear();
                const month = now.getMonth();
                const firstDay = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                let html = '';
                ['S','M','T','W','T','F','S'].forEach(d => {
                    html += `<div style="text-align:center; font-size:0.6rem; font-weight:800; padding-bottom:5px;">${d}</div>`;
                });

                for(let i=0; i<firstDay; i++) html += '<div></div>';

                const todayStr = now.toISOString().split('T')[0];

                for(let day=1; day <= daysInMonth; day++) {
                    const date = new Date(year, month, day);
                    const dateStr = `${year}-${String(month+1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                    
                    const habitsActiveForDay = habits.filter(h => {
                        const start = new Date(h.startDate);
                        start.setHours(0,0,0,0);
                        if (start > date) return false;
                        if (h.frequencyType === 'Custom' && h.customDays) {
                            const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
                            if (!h.customDays.includes(dayNames[date.getDay()])) return false;
                        }
                        return true;
                    });

                    let statusColor = 'transparent';
                    if (habitsActiveForDay.length > 0) {
                        const completed = habitsActiveForDay.filter(h => h.completedDates && h.completedDates.some(d => d.startsWith(dateStr))).length;
                        if (completed === habitsActiveForDay.length) statusColor = 'var(--accent-emerald)';
                        else if (completed > 0) statusColor = 'var(--accent-warning)';
                        else if (date < new Date().setHours(0,0,0,0)) statusColor = 'var(--accent-danger)';
                        else statusColor = 'rgba(255,255,255,0.1)';
                    }

                    const isToday = dateStr === todayStr;

                    html += `
                        <div onclick="showHabitDayDetails('${dateStr}')" 
                             style="aspect-ratio:1; display:flex; align-items:center; justify-content:center; font-size:0.7rem; border-radius:6px; cursor:pointer;
                                    position:relative;">
                            ${day}
                            ${statusColor !== 'transparent' ? `<div style="width:4px; height:4px; border-radius:50%; position:absolute; bottom:3px;"></div>` : ''}
                        </div>
                    `;
                }
                grid.innerHTML = html;
            }

