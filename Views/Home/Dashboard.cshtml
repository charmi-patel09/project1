            /* --- SEARCHABLE SELECT LOGIC --- */
            function toggleSearchableSelect(id) {
                const dropdown = document.getElementById(`${id}Dropdown`);
                const display = dropdown.previousElementSibling;
                
                // Close others
                document.querySelectorAll('.searchable-select-dropdown').forEach(d => {
                    if (d.id !== `${id}Dropdown`) d.classList.remove('show');
                });
                document.querySelectorAll('.searchable-select-display').forEach(d => {
                    if (d !== display) d.classList.remove('active');
                });

                dropdown.classList.toggle('show');
                display.classList.toggle('active');

                if (dropdown.classList.contains('show')) {
                    const input = dropdown.querySelector('input');
                    input.value = '';
                    filterSearchableSelect(id, '');
                    setTimeout(() => input.focus(), 50);
                }
            }

            function filterSearchableSelect(id, query) {
                const list = document.getElementById(`${id}Options`);
                const items = list.querySelectorAll('.option-item');
                const q = query.toLowerCase();
                
                items.forEach(item => {
                    const text = item.textContent.toLowerCase();
                    item.style.display = text.includes(q) ? 'flex' : 'none';
                });
            }

            function selectSearchableOption(id, value, label) {
                const select = document.getElementById(id);
                const display = document.getElementById(`${id}Selected`);
                const dropdown = document.getElementById(`${id}Dropdown`);
                const displayBox = dropdown.previousElementSibling;

                select.value = value;
                display.textContent = label;
                dropdown.classList.remove('show');
                displayBox.classList.remove('active');

                // Trigger change event
                const event = new Event('change');
                select.dispatchEvent(event);
            }

            // Close dropdowns on outside click
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.searchable-select-container')) {
                    document.querySelectorAll('.searchable-select-dropdown').forEach(d => d.classList.remove('show'));
                    document.querySelectorAll('.searchable-select-display').forEach(d => d.classList.remove('active'));
                }
            });

            async function initFiscal(preserveState = false) {
                const f = document.getElementById('fromCurrency');
                const t = document.getElementById('toCurrency');
                if (!f || !t) return;

                const currentVals = preserveState ? { f: f.value, t: t.value } : {};

                // 1. High priority and example cities
                const priorityCities = [
                    { country: "India", city: "Mumbai", currency: "INR", timezone: "Asia/Kolkata", code: "IN" },
                    { country: "India", city: "Delhi", currency: "INR", timezone: "Asia/Kolkata", code: "IN" },
                    { country: "India", city: "Bengaluru", currency: "INR", timezone: "Asia/Kolkata", code: "IN" },
                    { country: "United States", city: "New York", currency: "USD", timezone: "America/New_York", code: "US" },
                    { country: "United Kingdom", city: "London", currency: "GBP", timezone: "Europe/London", code: "GB" },
                    { country: "Japan", city: "Tokyo", currency: "JPY", timezone: "Asia/Tokyo", code: "JP" },
                    { country: "United Arab Emirates", city: "Dubai", currency: "AED", timezone: "Asia/Dubai", code: "AE" },
                    { country: "Australia", city: "Sydney", currency: "AUD", timezone: "Australia/Sydney", code: "AU" },
                    { country: "Canada", city: "Toronto", currency: "CAD", timezone: "America/Toronto", code: "CA" },
                    { country: "Singapore", city: "Singapore", currency: "SGD", timezone: "Asia/Singapore", code: "SG" }
                ];

                const createOpt = (c) => {
                    const val = `${c.currency}|${c.country}`;
                    const label = `${c.country}, ${c.city}`;
                    const opt = new Option(label, val);
                    opt.setAttribute('data-city', c.city);
                    opt.setAttribute('data-country', c.country);
                    opt.setAttribute('data-currency', c.currency);
                    opt.setAttribute('data-timezone', c.timezone);
                    return opt;
                };

                const populateDropdowns = (data) => {
                    f.innerHTML = ''; t.innerHTML = '';
                    const sorted = [...data].sort((a, b) => a.country.localeCompare(b.country) || a.city.localeCompare(b.city));
                    const currencyData = sorted.filter(c => c.currency); // Only countries with currencies for exchange
                    
                    const popNames = priorityCities.map(pc => pc.country);
                    
                    const addGroup = (selectEl, label, items) => {
                        if (items.length === 0) return;
                        const group = document.createElement('optgroup');
                        group.label = label;
                        items.forEach(c => group.appendChild(createOpt(c)));
                        selectEl.appendChild(group);
                    };

                    addGroup(f, 'Popular', currencyData.filter(c => popNames.includes(c.country)));
                    addGroup(f, 'Global', currencyData.filter(c => !popNames.includes(c.country)));
                    addGroup(t, 'Popular', currencyData.filter(c => popNames.includes(c.country)));
                    addGroup(t, 'Global', currencyData.filter(c => !popNames.includes(c.country)));

                    if (currentVals.f && currentVals.t) {
                        f.value = currentVals.f; t.value = currentVals.t;
                    } else {
                        const setDefault = (el, country, city) => {
                            for (let i = 0; i < el.options.length; i++) {
                                if (el.options[i].getAttribute('data-country') === country && 
                                    (!city || el.options[i].getAttribute('data-city') === city)) {
                                    el.selectedIndex = i; break;
                                }
                            }
                        };
                        setDefault(f, 'United States', 'New York');
                        setDefault(t, 'India', 'Mumbai');
                    }
                    
                    syncSearchableSelect('fromCurrency');
                    syncSearchableSelect('toCurrency');
                };

                // Load initial data
                globalLocationData = [...priorityCities];
                populateDropdowns(globalLocationData);
                initTimezones();

                // Fetch full list from API
                try {
                    const res = await fetch('https://restcountries.com/v3.1/all?fields=name,currencies,capital,timezones,cca2');
                    const allMeta = await res.json();
                    
                    const apiLocs = allMeta.map(c => {
                        const cur = (c.currencies && Object.keys(c.currencies).length > 0) ? Object.keys(c.currencies)[0] : null;
                        return {
                            country: c.name.common,
                            city: (c.capital && c.capital.length > 0) ? c.capital[0] : c.name.common,
                            currency: cur,
                            timezone: (c.timezones && c.timezones.length > 0) ? c.timezones[0] : 'UTC',
                            code: c.cca2
                        };
                    });

                    const seen = new Set();
                    globalLocationData = [...priorityCities, ...apiLocs].filter(loc => {
                        const key = `${loc.country}|${loc.city}`.toLowerCase();
                        if (seen.has(key)) return false;
                        seen.add(key);
                        return true;
                    });

                    populateDropdowns(globalLocationData);
                    initTimezones();
                    
                    emergencyCountryList = globalLocationData.map(c => ({ name: c.country, code: c.code }));
                } catch (e) {
                    console.error('Fiscal API error', e);
                }
            }

            function syncSearchableSelect(id) {
                const select = document.getElementById(id);
                const optionsList = document.getElementById(`${id}Options`);
                const display = document.getElementById(`${id}Selected`);
                
                if (!select || !optionsList) return;

                optionsList.innerHTML = '';
                
                const addOptionItem = (opt) => {
                    const item = document.createElement('div');
                    item.className = 'option-item';
                    if (opt.selected) item.classList.add('selected');
                    item.textContent = opt.text;
                    item.onclick = () => selectSearchableOption(id, opt.value, opt.text);
                    optionsList.appendChild(item);
                };

                Array.from(select.querySelectorAll('optgroup')).forEach(group => {
                    const label = document.createElement('div');
                    label.className = 'option-group-label';
                    label.textContent = group.label;
                    optionsList.appendChild(label);
                    
                    Array.from(group.querySelectorAll('option')).forEach(opt => addOptionItem(opt));
                });

                // If no optgroups, just list options
                if (select.querySelectorAll('optgroup').length === 0) {
                    Array.from(select.options).forEach(opt => addOptionItem(opt));
                }

                if (select.selectedIndex !== -1) {
                    display.textContent = select.options[select.selectedIndex].text;
                }
            }

            async function fetchLatestRates(shouldConvert = true) {
                const cur = document.getElementById('fromCurrency').value.split('|')[0];
                if (!cur) return;

                const display = document.getElementById('currencyResult');
                display.innerHTML = `<div class="loading-state"><i class="fas fa-sync fa-spin"></i> Syncing Rates...</div>`;

                try {
                    const res = await fetch(`https://open.er-api.com/v6/latest/${cur}`);
                    const data = await res.json();
                    window.baseCurrencyRates = data.rates;
                    document.getElementById('lastExchangeUpdate').innerText = `Last Synced: ${new Date().toLocaleTimeString()} (${cur})`;
                    if (shouldConvert) convertCurrency();
                } catch (e) { 
                    console.error('Rate fetch failed', e);
                    display.innerHTML = `<div class="error-state">Sync Failed</div>`;
                }
            }

            async function convertCurrency() {
                const amount = parseFloat(document.getElementById('amountInput').value) || 0;
                const fEl = document.getElementById('fromCurrency');
                const tEl = document.getElementById('toCurrency');
                const f = fEl.value.split('|')[0];
                const t = tEl.value.split('|')[0];

                if (!f || !t) return;

                const display = document.getElementById('currencyResult');

                if (!window.baseCurrencyRates || !window.baseCurrencyRates[t]) {
                    await fetchLatestRates();
                }

                const rate = window.baseCurrencyRates[t] || 1;
                const calc = amount * rate;

                // Build context for display
                const getMeta = (el) => {
                    const opt = el.options[el.selectedIndex];
                    return opt ? { city: opt.getAttribute('data-city'), country: opt.getAttribute('data-country'), timezone: opt.getAttribute('data-timezone') } : null;
                };
                
                const baseMeta = getMeta(fEl);
                const targetMeta = getMeta(tEl);
                const ctx = targetMeta || baseMeta;

                let locHtml = '';
                if (ctx) {
                    const time = ctx.timezone ? new Date().toLocaleTimeString('en-US', { timeZone: ctx.timezone, hour: '2-digit', minute: '2-digit' }) : '';
                    locHtml = `<div style="text-align:center; margin-bottom: 12px; padding: 10px; border-radius: 12px;">
                                   <div style="font-size: 0.65rem; text-transform: uppercase; opacity: 0.7;">Target Location</div>
                                   <div style="font-weight: 700; font-size: 0.9rem;"><i class="fas fa-location-dot"></i> ${ctx.country}, ${ctx.city}</div>
                                   ${time ? `<div style="font-size: 0.75rem; opacity: 0.6; margin-top: 2px;"><i class="fas fa-clock"></i> ${time}</div>` : ''}
                               </div>`;
                }

                display.innerHTML = `${locHtml}
                    <div class="val-grid">
                        <div class="val-box slide-in">
                            <div class="val-label">${f}</div>
                            <div class="val-number">${amount.toLocaleString(undefined, { minimumFractionDigits: 2 })}</div>
                        </div>
                        <div class="val-box slide-in">
                            <div class="val-label">${t}</div>
                            <div class="val-number highlight">${calc.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</div>
                        </div>
                    </div>`;
            }

            function initTimezones() {
                const select = document.getElementById('timezoneSelect');
                if (!select) return;

                const currentVal = select.value;
                select.innerHTML = '';

                const sorted = [...globalLocationData].sort((a, b) => a.country.localeCompare(b.country) || a.city.localeCompare(b.city));
                const seen = new Set();

                sorted.forEach(loc => {
                    if (!loc.timezone) return;
                    const label = `${loc.country}, ${loc.city}`;
                    if (seen.has(label)) return;
                    seen.add(label);

                    const opt = new Option(label, loc.timezone);
                    if (loc.timezone === currentVal) opt.selected = true;
                    select.appendChild(opt);
                });

                if (select.selectedIndex === -1) {
                    for (let i = 0; i < select.options.length; i++) {
                        if (select.options[i].value === 'Asia/Kolkata') { select.selectedIndex = i; break; }
                    }
                }

                syncSearchableSelect('timezoneSelect');
                updateConvertedTime();
            }

            // Helper to get rigorous locale for formatting
            function getCurrentLocale() {
                const lang = (window.translator && window.translator.currentLang) ? window.translator.currentLang : 'en';
                const map = {
                    'en': 'en-US',
                    'es': 'es-ES',
                    'fr': 'fr-FR',
                    'de': 'de-DE',
                    'hi': 'hi-IN',
                    'gu': 'gu-IN',
                    'zh': 'zh-CN',
                    'ja': 'ja-JP',
                    'ru': 'ru-RU',
                    'ar': 'ar-EG'
                };
                return map[lang] || 'en-US';
            }

            function runChronos() {
                try {
                    const now = new Date();
                    const locale = getCurrentLocale();

                    const dateEl = document.getElementById('headerDate');
                    if (dateEl) {
                        // Use format: Weekday, Month Day, Year (in locale)
                        // e.g. Friday, January 23, 2026
                        dateEl.innerText = now.toLocaleDateString(locale, {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                    }

                    const timeEl = document.getElementById('headerTime');
                    if (timeEl) {
                        timeEl.innerText = now.toLocaleTimeString(locale, { hour12: false });
                        // Should we use hour12 based on locale? Default is usually good.
                        // But military time is often preferred in dashboards. 
                        // Let's stick to locale default but maybe force 2-digit? 
                        // User said "clean, readable format similar to English".
                        // Most locales do HH:mm:ss nicely.
                        // Actually, let's trust the locale default for TimeString.
                        timeEl.innerText = now.toLocaleTimeString(locale);
                    }

                    const localLargeEl = document.getElementById('localTimeLarge');
                    if (localLargeEl) localLargeEl.innerText = now.toLocaleTimeString(locale);

                    // Also update the accent box if it exists
                    if (typeof updateConvertedTime === 'function') updateConvertedTime();
                } catch (e) {
                    console.error("Chronos Error:", e);
                    // Hard Fallback
                    try {
                        const fb = new Date().toLocaleTimeString();
                        if (document.getElementById('headerTime')) document.getElementById('headerTime').innerText = fb;
                    } catch (z) { }
                }
            }

            function updateConvertedTime() {
                const zone = document.getElementById('timezoneSelect').value;
                const now = new Date();
                const locale = getCurrentLocale();

                try {
                    const timeString = now.toLocaleTimeString(locale, { timeZone: zone });
                    const dateString = now.toLocaleDateString(locale, { timeZone: zone, weekday: 'short', month: 'short', day: 'numeric' });

                    // Get offset safely - keeping this part English-y or technical is often better for "GMT+5" etc.
                    // But let's try locale.
                    const typePart = Intl.DateTimeFormat(locale, { timeZone: zone, timeZoneName: 'longOffset' }).formatToParts(now).find(p => p.type === 'timeZoneName');
                    const type = typePart ? typePart.value : zone;

                    document.getElementById('convertedTime').innerHTML = `<div class="no-translate">${timeString} <span style="font-size:0.5em; opacity:0.7; display:block;">${dateString} • ${type}</span></div>`;
                } catch (e) {
                    console.error("Time calc error", e);
                }
            }

