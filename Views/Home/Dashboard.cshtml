                                                                                                                                                                                                                                                                                        <button class="btn-note-action delete" onclick="event.stopPropagation(); deleteNote(${note.id})"><i class="fas fa-trash"></i></button>
                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                `;
                    container.appendChild(div);
                });
