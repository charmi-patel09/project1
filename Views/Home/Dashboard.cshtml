            function updateHabitAnalyticsUI(data) {
                const el = document.getElementById('dailyProgress');
                if (el) {
                    el.innerHTML = `<span title="Completed/Missed this week" style="cursor:help; display:flex; gap:10px;">
                        <span><i class="fas fa-calendar-check" ></i> ${data.weeklyCompleted}</span>
                        <span><i class="fas fa-calendar-times" ></i> ${data.weeklyMissed}</span>
                    </span>`;
                }

                // Update Mini Analytics (Inside Widget)
                const today = new Date();
                today.setHours(0,0,0,0);
                const todayStr = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
                const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
                const todayName = dayNames[today.getDay()];

                let activeToday = 0;
                let doneToday = 0;

                habits.forEach(h => {
                    const start = new Date(h.startDate);
                    start.setHours(0,0,0,0);
                    if (start > today) return;

                    let isActive = true;
                    if (h.frequencyType === 'Custom' && h.customDays && h.customDays.length > 0) {
                        if (!h.customDays.includes(todayName)) isActive = false;
                    }

                    if (isActive) {
                        activeToday++;
                        const isDone = h.completedDates && h.completedDates.some(d => d.startsWith(todayStr));
                        if (isDone) doneToday++;
                    }
                });

                if (document.getElementById('habitTotalCount')) document.getElementById('habitTotalCount').innerText = activeToday;
                if (document.getElementById('habitDoneCount')) document.getElementById('habitDoneCount').innerText = doneToday;
                if (document.getElementById('habitPendingCount')) document.getElementById('habitPendingCount').innerText = activeToday - doneToday;
            }

