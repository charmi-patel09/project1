                let todayTasks = [];

                allGoals.forEach(g => {
                    const tasks = g.dailyTasks.filter(t => t.date.split('T')[0] === today);
                    tasks.forEach(t => todayTasks.push({ goalId: g.id, goalTitle: g.title, ...t }));
                });

                if (todayTasks.length === 0) {
                    listSection.style.display = 'none';
                    return;
