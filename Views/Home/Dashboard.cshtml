            let notifiedHabitsToday = {}; 

            async function requestNotificationPermission() {
                if (!("Notification" in window)) {
                    console.log("This browser does not support desktop notification");
                    return false;
                }
                
                if (Notification.permission === "granted") return true;
                
                if (Notification.permission !== "denied") {
                    const permission = await Notification.requestPermission();
                    return permission === "granted";
                }
                return false;
            }

            function checkHabitReminders() {
                const now = new Date();
                const hh = String(now.getHours()).padStart(2, '0');
                const mm = String(now.getMinutes()).padStart(2, '0');
                const timeStr = `${hh}:${mm}`; // Standard format for comparison
                
                // Clear notification cache at the start of a new day
                if (hh === "00" && mm === "00") {
                    notifiedHabitsToday = {};
                }

                habits.forEach(h => {
                    if (!h.reminderTime) return;

                    // Normalize habit reminder time to HH:mm (handling HH:mm:ss if present)
                    const normalizedReminder = h.reminderTime.split(':').slice(0, 2).join(':');

                    if (normalizedReminder === timeStr) {
                        const key = `${h.id}-${timeStr}`;
                        if (!notifiedHabitsToday[key]) {
                            // 1. Show In-Dashboard UI Alert
                            showHabitReminderUI(h);
                            
                            // 2. Trigger Browser Notification
                            if (Notification.permission === "granted") {
                                try {
                                    new Notification(`Habit Reminder: ${h.name}`, { 
                                        body: h.description || h.goal || "Stay on track with your habits!",
                                        icon: '/favicon.ico',
                                        tag: key, // Prevents duplicate windows for same habit
                                        requireInteraction: true // Keeps notification visible until user acts
                                    });
                                } catch (err) {
                                    console.error("Notification trigger failed:", err);
                                }
                            }
                            
                            notifiedHabitsToday[key] = true;
                        }
                    }
                });
            }

