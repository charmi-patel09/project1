@model JsonCrudApp.Models.Student
@inject JsonCrudApp.Services.RoleWidgetService RoleWidgetService

@{
    bool isEdit = ViewData["IsEdit"] as bool? ?? false;
    // FETCH: Backend enforcement starts here by fetching mapping from service
    var roleWidgets = RoleWidgetService.GetRoleWidgets().ToDictionary(r => r.Role, r => r.AllowedWidgets.Split(','));
    
    // Determine initially checked widgets based on current model role
    var currentRole = Model?.Role ?? "Visitor";
    var allowedParams = roleWidgets.ContainsKey(currentRole) ? roleWidgets[currentRole] : (roleWidgets.ContainsKey("Visitor") ? roleWidgets["Visitor"] : new string[0]);

    bool HasPermission(string widgetId)
    {
        return allowedParams.Contains(widgetId);
    }

    var allWidgets = JsonCrudApp.Services.RoleWidgetService.AvailableWidgets;
}

<style>
    .create-user-container { max-width: 800px; margin: 0 auto; }
    .form-card { background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-card) 100%) !important; border: 1px solid var(--border-primary); border-radius: 16px; padding: 32px; box-shadow: var(--shadow-lg); }
    .form-title { color: var(--text-color); font-family: var(--font-heading); font-weight: 700; margin-bottom: 24px; border-bottom: 1px solid var(--border-primary); padding-bottom: 16px; }
    .form-label { color: var(--text-color); font-size: 0.9rem; font-weight: 500; margin-bottom: 8px; opacity: 0.8; }
    .form-control, .form-select, textarea { background-color: var(--bg-tertiary); border: 1px solid var(--border-secondary); color: var(--text-primary) !important; border-radius: 12px; padding: 12px 16px; font-size: 0.95rem; }
    .form-control::placeholder, textarea::placeholder { color: var(--text-primary) !important; opacity: 0.7; }
    .form-control:focus, .form-select:focus, textarea:focus { background-color: var(--bg-secondary); border-color: var(--accent-primary); box-shadow: 0 0 0 4px rgba(var(--accent-primary-rgb, 88, 166, 255), 0.15); color: var(--text-primary) !important; }

    .widget-section-card { background: rgba(var(--text-primary-rgb, 15, 23, 42), 0.02); border: 1px solid var(--border-secondary); border-radius: 12px; padding: 24px; margin-top: 32px; }
    .section-title { color: var(--text-color); font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; }
    
    .widget-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-top: 16px; }
    .widget-item { background: rgba(var(--text-primary-rgb, 15, 23, 42), 0.03); padding: 12px 15px; border-radius: 10px; border: 1px solid var(--border-secondary); display: flex; align-items: center; gap: 12px; transition: all 0.2s; }
    
    /* STYLING RULE: Only checkbox is disabled, label remains bright */
    .form-check-input { width: 1.25rem; height: 1.25rem; margin-top: 0; cursor: not-allowed !important; opacity: 0.6; filter: grayscale(1); }
    .form-check-input:checked { opacity: 1; filter: none; background-color: var(--accent-primary); border-color: var(--accent-primary); }
    .form-check-label { color: var(--text-color) !important; font-weight: 600; font-size: 0.9rem; cursor: default; }
    
    .btn-create { background: var(--accent-primary); color: white; border: none; padding: 14px 24px; border-radius: 12px; font-weight: 600; font-size: 1rem; width: 100%; margin-top: 32px; transition: all 0.2s ease; }
    .btn-create:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: var(--shadow-lg); }
    
    .tamper-alert { color: var(--accent-danger); font-size: 0.75rem; font-weight: 700; margin-top: 4px; display: none; }
    
    /* Global internal text force */
    .text-muted { color: var(--text-color) !important; opacity: 0.7; }
</style>

<div class="create-user-container">
    <div class="form-card">
        <h2 class="form-title">@(isEdit ? "Update User Profile" : "Onboard New User")</h2>

        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" autocomplete="off" id="userForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @if (isEdit) { <input type="hidden" asp-for="Id" /> }

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Full Name</label>
                    <input asp-for="Name" class="form-control" placeholder="John Smith" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    @if (isEdit) { <input asp-for="Email" class="form-control" readonly style="opacity: 0.7;" /> }
                    else { <input asp-for="Email" class="form-control" placeholder="jsmith@example.com" /> }
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Account Password</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Security Role</label>
                    <select asp-for="Role" class="form-select" id="roleSelect">
                        @foreach (var role in roleWidgets.Keys.Where(r => !r.Equals("normal", StringComparison.OrdinalIgnoreCase)))
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Age" class="form-label">User Age</label>
                    <input asp-for="Age" type="number" class="form-control" placeholder="25" />
                </div>

                <div class="col-md-6">
                    <label asp-for="SecurityPin" class="form-label">Security PIN (Optional)</label>
                    <input asp-for="SecurityPin" type="password" maxlength="6" class="form-control" placeholder="4-6 Digits" />
                    <div class="text-muted small mt-1">Leave blank to disable PIN protection.</div>
                </div>
            </div>

            <!-- Widget Access Protocol Section -->
            <div class="widget-section-card">
                <h4 class="section-title">Strict Widget Access</h4>
                <p class="text-muted small mb-0">Permissions are automatically enforced based on selection in the Role Protocol. Manual overrides are restricted.</p>
                
                <div class="widget-grid" id="widgetContainer">
                    @foreach (var widget in allWidgets)
                    {
                        <div class="widget-item" data-widget-id="@widget.Key">
                            <input class="form-check-input widget-chk" type="checkbox"
                                value="@widget.Key" id="w_@widget.Key" 
                                @(HasPermission(widget.Key) ? "checked" : "")
                                disabled>
                            <label class="form-check-label" for="w_@widget.Key">@widget.Value</label>
                        </div>
                    }
                </div>
                <div id="tamperWarning" class="tamper-alert"><i class="fas fa-shield-alt"></i> Security Override Detected: Permissions Restored to System Defaults.</div>
            </div>

            <button type="submit" class="btn-create">@(isEdit ? "Apply Changes" : "Confirm & Register")</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const roleSelect = document.getElementById('roleSelect');
        const widgetCheckboxes = document.querySelectorAll('.widget-chk');
        const tamperWarning = document.getElementById('tamperWarning');

        // ROLE MAPPING: Derived from backend service
        const roleMapping = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(roleWidgets));

        function updateWidgets() {
            const role = roleSelect.value;
            const allowed = roleMapping[role] || [];

            widgetCheckboxes.forEach(chk => {
                chk.checked = allowed.includes(chk.value);
                // Force disabled state even if someone tries to enable it via console
                chk.disabled = true;
            });
        }

        roleSelect.addEventListener('change', updateWidgets);

        // ANTI-TAMPERING: Prevent manual override via browser dev tools
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'attributes' && (mutation.attributeName === 'disabled' || mutation.attributeName === 'checked')) {
                    if (!mutation.target.disabled) {
                        mutation.target.disabled = true;
                        tamperWarning.style.display = 'block';
                        setTimeout(() => tamperWarning.style.display = 'none', 3000);
                        updateWidgets(); // Restore state
                    }
                }
            });
        });

        widgetCheckboxes.forEach(chk => {
            observer.observe(chk, { attributes: true });
        });

        // Initial Sync
        updateWidgets();
    });
</script>

