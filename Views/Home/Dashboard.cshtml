                                    </div>
                                    <div class="options-list" id="fromCurrencyOptions"></div>
                                </div>
                                <select id="fromCurrency" class="modern-select" onchange="fetchLatestRates()" style="display:none;"></select>
                            </div>
                        </div>
                        <div class="swap-indicator" onclick="swapCurrencies()" title="Swap Currencies"><i class="fas fa-right-left"></i></div>
                        <div class="form-row">
                            <label>To</label>
                            <div class="searchable-select-container" data-id="toCurrency">
                                <div class="searchable-select-display" onclick="toggleSearchableSelect('toCurrency')">
                                    <span id="toCurrencySelected">Loading...</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                                <div class="searchable-select-dropdown" id="toCurrencyDropdown">
                                    <div class="search-input-wrapper">
                                        <input type="text" placeholder="Search country or city..." onclick="event.stopPropagation()" oninput="filterSearchableSelect('toCurrency', this.value)">
                                    </div>
                                    <div class="options-list" id="toCurrencyOptions"></div>
                                </div>
                                <select id="toCurrency" class="modern-select" onchange="convertCurrency()" style="display:none;"></select>
                            </div>
                        </div>
                    </div>
                    <div class="action-row" style="margin-top: 10px;"><button onclick="fetchLatestRates()" class="btn-emerald" style="width: 100%;"><i class="fas fa-bolt"></i> <span>Refresh Rates</span></button></div>
                        <div class="result-section">
                            <div class="result-status"><label class="result-header">Value</label><div class="live-tag"><span class="pulse-dot"></span><span>LIVE</span></div></div>
                            <div id="currencyResult" class="valuation-output"><div style="padding: 20px; text-align: center; opacity: 0.6; font-size: 0.9rem;"><i class="fas fa-coins"></i> <span>Convert</span></div></div>
                            <div class="update-info no-translate" id="lastExchangeUpdate"><span>Last Sync</span>: --:--:--</div>
                        </div>
                    </div>
