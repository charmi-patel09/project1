            function getLocalData(key) {
                try {
                    const raw = localStorage.getItem(key);
                    
                    // Fallback / Migration Logic
                    if (!raw) {
                         // Check for old non-user-specific keys (Migration)
                         // Only migrate if we are currently looking for the CURRENT user's data
                         // and it's missing.
                         // But wait, if multiple users exist on same browser, we shouldn't steal "global" data
                         // indiscriminately. 
                         // However, previously the app was single-tenant local storage. 
                         // Strategy: If "new" key empty, try "old" key. If found, COPY it to new key.
                         
                         let oldKey = null;
                         if (key.includes('pdf')) oldKey = 'user_pdf_history_v1';
                         else if (key.includes('notes')) oldKey = 'user_notes_data_v1';
                         else if (key.includes('habits')) oldKey = 'user_habits_data_v1';
                         
                         if(oldKey) {
                             const oldData = localStorage.getItem(oldKey);
                             if(oldData) {
                                 console.log(`[Data] Migrating data from ${oldKey} to ${key}`);
                                 localStorage.setItem(key, oldData);
                                 return JSON.parse(oldData);
                             }
                         }

                         // Legacy fallback (v0)
                         if (key.includes('notes')) return JSON.parse(localStorage.getItem('notes_data') || '[]');
                         if (key.includes('habits')) return JSON.parse(localStorage.getItem('habits_data') || '[]');
                         if (key.includes('habits')) {
                             // SPECIAL REQUEST: Check "habitData" as requested previously
                             const hd = localStorage.getItem("habitData");
                             if(hd) return JSON.parse(hd);
                         }
                    }
                    return raw ? JSON.parse(raw) : [];
                } catch (e) {
                    console.error("Data Load Error:", e);
                    return [];
                }
            }

            function saveLocalData(key, data) {
