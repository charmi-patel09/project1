@using Microsoft.AspNetCore.Http
@{
    // Logic:
    // 1. Admin always sees all.
    // 2. Legacy users (WidgetPermissions is null) see all.
    // 3. New users (WidgetPermissions is not null) see only what is in the list.
    var role = ViewBag.Role as string ?? "";
    string? rawPermissions = ViewBag.WidgetPermissions as string;
    
    var allowedParams = (rawPermissions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
    
    bool CanShow(string widgetId) 
    {
        if (role == "Admin") return true; 
        if (rawPermissions == null) return true; // Legacy: No permissions set yet -> Allow All
        return allowedParams.Contains(widgetId);
    }
    
    bool IsAdmin = role == "Admin";
    bool isVisitor = role == "Visitor";
    bool IsSecurityEnabled = ViewBag.IsSecurityEnabled ?? false;
    bool IsUnlocked = ViewBag.IsUnlocked ?? false;
    
    bool IsHabitUnlocked = ViewBag.IsHabitUnlocked ?? false;
    bool IsPdfUnlocked = ViewBag.IsPdfUnlocked ?? false;
    bool IsNotesUnlocked = ViewBag.IsNotesUnlocked ?? false;
    
    // Console logs for verification
    var habitSession = Context.Session.GetString("Unlocked_habit-hub") ?? "null";
    var pdfSession = Context.Session.GetString("Unlocked_pdf-hub") ?? "null";
    var notesSession = Context.Session.GetString("Unlocked_notes-hub") ?? "null";
    var securityEnabled = IsSecurityEnabled.ToString().ToLower();
    var habitUnlocked = IsHabitUnlocked.ToString().ToLower();
    var pdfUnlocked = IsPdfUnlocked.ToString().ToLower();
    var notesUnlocked = IsNotesUnlocked.ToString().ToLower();

    var logScript = "<script>" +
        "console.log('%c --- Security PIN Debug --- ', 'background: #222; color: #bada55; font-weight: bold;');" +
        $"console.log('User Role:', '{role}');" +
        $"console.log('Security Enabled (DB):', {securityEnabled});" +
        "console.log('--- Individual Widget States (Server-Side) ---');" +
        $"console.log('Habit Unlocked:', {habitUnlocked});" +
        $"console.log('PDF Unlocked:', {pdfUnlocked});" +
        $"console.log('Notes Unlocked:', {notesUnlocked});" +
        "console.log('--- Session Debug ---');" +
        $"console.log('Habit Session:', '{habitSession}');" +
        $"console.log('PDF Session:', '{pdfSession}');" +
        $"console.log('Notes Session:', '{notesSession}');" +
        "console.log('---------------------------');" +
        "</script>";

    // Helper to render the lock screen
    Microsoft.AspNetCore.Html.HtmlString RenderLockScreen(string widgetId)
    {
        string icon = IsSecurityEnabled ? "fa-shield-halved" : "fa-lock-open";
        string title = "This Widget is Locked";
        string subtext = IsSecurityEnabled ? "Access is restricted. Requires Security PIN verification." : "Security PIN not configured. Setup PIN to secure this tool.";
        string btnText = IsSecurityEnabled ? "Unlock with PIN" : "Configure PIN";
        string btnAction = IsSecurityEnabled ? $"console.log('[SECURITY] Unlock button clicked for {widgetId}'); openPinModal('{widgetId}')" : "showSetupPin()";
        string extraClass = IsSecurityEnabled ? "" : "lock-not-configured";

        var html = $@"
            <div class='lock-screen {extraClass}' id='lock-{widgetId}'>
                <div class='lock-screen-header'>
                    <div class='lock-screen-icon'>
                        <i class='fas {icon}'></i>
                    </div>
                    <h4>{title}</h4>
                    <p>{subtext}</p>
                </div>";
        
        if (IsSecurityEnabled) {
            html += $@"<button onclick=""{btnAction}"" class=""btn-unlock-widget""><i class=""fas fa-key""></i> {btnText}</button>";
        } else {
             html += $@"<button onclick=""{btnAction}"" class=""btn-unlock-widget"" background:rgba(255,255,255,0.1); color:var(--text-muted); box-shadow:none;""><i class=""fas fa-cog""></i> {btnText}</button>";
        }
        
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}
@Html.Raw(logScript)

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

