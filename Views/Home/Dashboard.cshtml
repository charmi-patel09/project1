<!-- Habit Notification Container -->
<div id="habitToastContainer" style="position: fixed; top: 20px; right: 20px; z-index: 10000; display: flex; flex-direction: column; gap: 10px; pointer-events: none;"></div>

<style>
    .habit-toast {
        background: rgba(20, 20, 25, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-left: 4px solid #10b981;
        padding: 16px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        min-width: 300px;
        color: #fff;
        font-family: 'Inter', sans-serif;
        transform: translateX(120%);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        pointer-events: auto;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }
    .habit-toast.show {
        transform: translateX(0);
    }
    .habit-toast-content {
        flex: 1;
    }
    .habit-toast-title {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 4px;
        color: #10b981;
    }
    .habit-toast-msg {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.7);
        line-height: 1.4;
    }
    .habit-toast-close {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        padding: 4px;
        font-size: 1rem;
        transition: color 0.2s;
    }
    .habit-toast-close:hover {
        color: #fff;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Only run if Habit Tracker is present on the page (checks for the widget class)
        // Also check if habit-hub exists to avoid errors on pages where it might be hidden
        const habitWidget = document.querySelector('.habit-hub');
        // Even if the DOM element isn't strictly there (e.g. collapsed), better to check if user has permission?
        // But the requirement says "It must work inside the Habit Tracker widget only".
        // If the widget is not rendered (permission denied), we shouldn't show notifications.
        if (!habitWidget) return;

        const container = document.getElementById('habitToastContainer');

        function showHabitToast(title, message) {
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'habit-toast';
            
            toast.innerHTML = `
                <div style="font-size: 1.2rem;"><i class="fas fa-bell"></i></div>
                <div class="habit-toast-content">
                    <div class="habit-toast-title">${title}</div>
                    <div class="habit-toast-msg">${message}</div>
                </div>
                <button class="habit-toast-close" onclick="this.parentElement.remove()" title="Dismiss"><i class="fas fa-times"></i></button>
            `;

            container.appendChild(toast);

            // Force reflow for transition
            void toast.offsetWidth;

            requestAnimationFrame(() => {
                toast.classList.add('show');
            });

            // Auto dismiss after 5 seconds
            const autoDismiss = setTimeout(() => {
                dismissToast(toast);
            }, 5000);

            // Allow canceling auto-dismiss on hover? (Requirement doesn't specify, but good UX)
            // But let's stick to simple "Auto dismiss after 5 seconds".
        }

        function dismissToast(toast) {
            if (toast && toast.parentElement) {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400); // Match transition duration
            }
        }

        async function checkHabitReminders() {
            try {
                // Call the endpoint
                const res = await fetch('/Habit/CheckReminders');
                if (res.ok) {
                    const habits = await res.json(); // returns array of { id, name, description }
                    
                    if (Array.isArray(habits) && habits.length > 0) {
                        habits.forEach(h => {
                            showHabitToast(
                                "Habit Reminder", 
                                `Time for <b>${h.name}</b>!<br>Let's get it done.`
                            );
                        });
                    }
                }
            } catch (e) {
                console.error("Reminder check failed", e);
            }
        }

        // Start polling - 60 seconds
        setInterval(checkHabitReminders, 60000);
        
        // Initial check after 2 seconds
        setTimeout(checkHabitReminders, 2000);
    });
</script>
