                        <div class="title-icon orange-glow">
                            <i class="fas fa-language"></i>
                        </div>
                        <div class="title-text">
                            <h3>Translator</h3>
                        </div>
                    </div>

                    <div class="tool-body" id="translatorBody" style="gap: 16px;">
