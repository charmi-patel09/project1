                                    <span title="Completed" >D:<b id="habitDoneCount">0</b></span>
                                    <span title="Pending" >P:<b id="habitPendingCount">0</b></span>
                                </div>
                                <button onclick="openHabitCalendar()" class="btn-icon" title="View History"><i class="fas fa-calendar-days"></i></button>
                                <div id="dailyProgress" style="display:none;">0/0</div>
                            </div>
                        }
                    </div>

                    <div class="tool-body" id="habitBody" style="height: 100%; display: flex; flex-direction: column;">
                        @if (IsHabitUnlocked) {
                            <div id="habitList" class="habit-list" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                                <div class="loading-state">Syncing Habits...</div>
