@model IEnumerable<JsonCrudApp.Models.RoleWidget>
@{
    ViewData["Title"] = "Role Permission Control";
    var allWidgets = JsonCrudApp.Services.RoleWidgetService.AvailableWidgets;
}

<div class="container mt-4">
    <div class="card glass-panel shadow-lg border-0"
        style="backdrop-filter: blur(20px); border-radius: 20px;">

        <div class="card-header border-0  py-4 px-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class=" mb-1 fw-bold"><i class="fas fa-user-lock me-2"></i> Role Permissions</h2>
                <p class="text-muted small mb-0">Changes apply instantly to all users assigned to the specified role.
                </p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal"
                    data-bs-target="#addRoleModal">
                    <i class="fas fa-plus me-2"></i>Add New Role
                </button>
                <a href="@Url.Action("Dashboard", "Home")"
                    class="btn btn-outline-light btn-sm rounded-pill px-4 d-flex align-items-center">
                    <i class="fas fa-home me-2"></i>Return to Dashboard
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 mb-4" role="alert"
                    >
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 mb-4" role="alert"
                    >
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row g-4">
                @foreach (var roleWidget in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <!-- FORM PER ROLE CARD -->
                        <form asp-action="Update" method="post" class="h-100">
                            <div class="card h-100 border-0 rounded-4"
                                style="padding: 24px;">

                                <input type="hidden" name="role" value="@roleWidget.Role" />

                                <div
                                    class="mb-4 d-flex justify-content-between align-items-center pb-3 border-bottom border-light border-opacity-10">
                                    <div class="d-flex align-items-center">
                                        <span
                                            class="badge rounded-pill @(roleWidget.Role == "Admin" ? "bg-danger" : "bg-primary") px-3 py-2"
                                            style="font-size: 0.8rem; letter-spacing: 0.5px;">
                                            @roleWidget.Role.ToUpper()
                                        </span>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-circle shadow-sm"
                                        onclick="showDeleteModal('@roleWidget.Role')" title="Delete Role"
                                        style="width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
                                        <i class="fas fa-trash-alt" style="font-size: 0.9rem;"></i>
                                    </button>
                                </div>

                                <div class="widget-selection-area mb-4"
                                    style="max-height: 350px; overflow-y: auto; padding-right: 10px;">
                                    @foreach (var widget in allWidgets)
                                    {
                                        var isSelected = (roleWidget.AllowedWidgets ?? "").Split(',').Contains(widget.Key);
                                        <div class="widget-row-item d-flex align-items-center mb-2 p-2 rounded-3"
                                            style="transition: 0.2s;">

                                            <!-- VISIBLE CHECKBOX -->
                                            <input type="checkbox" name="widgets" value="@widget.Key"
                                                id="chk_@(roleWidget.Role)_@(widget.Key)" class="standard-checkbox me-3"
                                            @(isSelected ? "checked" : "")>

                                            <label class=" small mb-0 w-100"
                                                style="cursor: pointer; user-select: none;"
                                                for="chk_@(roleWidget.Role)_@(widget.Key)">
                                                @widget.Value
                                            </label>
                                        </div>
                                    }
                                </div>

                                <button type="submit"
                                    class="btn btn-primary w-100 rounded-pill py-2 fw-bold mt-auto shadow-sm">
                                    <i class="fas fa-save me-2"></i>Update @roleWidget.Role
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    

    /* FORCED VISIBILITY FOR CHECKBOXES */
    .standard-checkbox {
        appearance: checkbox !important;
        -webkit-appearance: checkbox !important;
        -moz-appearance: checkbox !important;
        opacity: 1 !important;
        display: inline-block !important;
        width: 18px !important;
        height: 18px !important;
        cursor: pointer;
        accent-color: #4f46e5;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
    }

    .widget-row-item:hover {
        background: rgba(255, 255, 255, 0.08) !important;
    }

    .widget-selection-area::-webkit-scrollbar {
        width: 4px;
    }

    .widget-selection-area::-webkit-scrollbar-track {
        background: transparent;
    }

    .widget-selection-area::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border: none;
        transition: 0.3s transform;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    .modal-content {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.1);
        border-color: #6366f1;
        color: white;
        box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.25);
    }
</style>

<!-- ADD ROLE MODAL -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Create New Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Role Name</label>
                        <input type="text" name="roleName" class="form-control rounded-3"
                            placeholder="e.g. Moderator, Manager" required autofocus>
                        <p class="small text-muted mt-2 mb-0">Note: All current dashboard widgets will be automatically
                            enabled for this role. You can customize them after creation.</p>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-link  text-decoration-none"
                        data-bs-toggle="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow-lg border-0"
            style="backdrop-filter: blur(15px);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold "><i
                        class="fas fa-exclamation-triangle text-danger me-2"></i>Delete Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                    aria-label="Close"></button>
            </div>
            <div class="modal-body py-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-user-slash text-danger" style="font-size: 3rem;"></i>
                </div>
                <h4 class=" mb-2">Are you absolutely sure?</h4>
                <p class="text-muted mb-0">You are about to delete the role: <span id="displayRoleName"
                        class=" fw-bold"></span></p>
                <div class="alert alert-warning mt-3 bg-opacity-10 border-0 text-start small"
                    >
                    <i class="fas fa-info-circle me-2"></i><strong>Security Protocol:</strong> All users currently
                    assigned to this role will be automatically reassigned to the <strong>Visitor</strong> role to
                    prevent service interruption.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-link  text-decoration-none px-4"
                    data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-5 fw-bold" onclick="executeDelete()">Yes,
                    Delete Role</button>
            </div>
        </div>
    </div>
</div>

<!-- HIDDEN DELETE FORM -->
<form id="deleteRoleForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" name="role" id="deleteRoleName" />
</form>

@section Scripts {
    <script>
        let roleToDelete = "";
        let deleteBtnModal = null;

        function showDeleteModal(role) {
            roleToDelete = role;
            document.getElementById('displayRoleName').textContent = role;

            // Initialize modal if not already initialized
            if (!deleteBtnModal) {
                const modalElement = document.getElementById('deleteConfirmModal');
                if (modalElement) {
                    deleteBtnModal = new bootstrap.Modal(modalElement);
                }
            }

            if (deleteBtnModal) {
                deleteBtnModal.show();
            } else {
                console.error("Bootstrap Modal could not be initialized.");
                // Fallback to confirm for critical failure
                if (confirm(`Are you sure you want to delete the role '${role}'?`)) {
                    executeDelete();
                }
            }
        }

        function executeDelete() {
            if (!roleToDelete) return;
            document.getElementById('deleteRoleName').value = roleToDelete;
            document.getElementById('deleteRoleForm').submit();
        }
    </script>
}
