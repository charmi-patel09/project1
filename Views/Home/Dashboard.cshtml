            async function saveNewHabit() {
                const hiddenId = document.getElementById('editHabitId').value;
                const habitId = hiddenId || editingHabitId; // Use hidden field primarily

                const name = document.getElementById('newHabitName').value.trim();
                const goal = document.getElementById('newHabitGoal').value.trim();
                const category = document.getElementById('newHabitCategory').value;
                const startDate = document.getElementById('newHabitStartDate').value;
                const freqType = document.getElementById('newHabitType').value;
                
                if (!name || !startDate) return alert("Please fill Name and Start Date");

                // Reminder Logic
                const isFixed = document.querySelector('input[name="reminderType"][value="FixedTime"]').checked;
                let reminderType = "FixedTime";
                let reminderTime = "";
                let reminderDuration = 0;

                if (isFixed) {
                    reminderTime = document.getElementById('newHabitReminder').value;
                } else {
                    reminderType = "AfterDuration";
                    const val = parseInt(document.getElementById('newHabitDurationValue').value) || 0;
                    const unit = parseInt(document.getElementById('newHabitDurationUnit').value) || 1;
                    reminderDuration = val * unit;
                }

                // Custom Days
                let customDays = [];
                if (freqType === 'Custom') {
                    document.querySelectorAll('#customDaysInput input:checked').forEach(cb => {
                        customDays.push(cb.value);
                    });
                    if(customDays.length === 0) return alert("Select at least one day for Custom Frequency.");
                }

                const payload = {
                    Id: habitId || undefined,
                    Name: name,
                    Description: goal,
                    Goal: goal,
                    Category: category,
                    StartDate: startDate,
                    FrequencyType: freqType,
                    CustomDays: customDays,
                    ReminderTime: reminderTime,
                    ReminderType: reminderType,
                    ReminderDuration: reminderDuration
                };

                try {
                    const url = habitId ? '/Habit/Edit' : '/Habit/Create';
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (res.ok) {
                        toggleAddHabitForm(true);
                        initHabits();
                    } else {
                        const errorText = await res.text();
                        alert(errorText || 'Failed to save habit');
                    }
                } catch (e) { 
                    console.error(e);
                    alert("Network error. Please try again.");
                }
            }

