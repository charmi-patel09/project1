<!-- Utility Controls (Theme + Translate + Clock) -->
<div class="utility-container d-flex align-items-center gap-2" id="utilityContainer">

    <!-- 1. Time Tracker (Clock) - Only show if authenticated -->
    @using Microsoft.AspNetCore.Http
    @if (!string.IsNullOrEmpty(Context.Session.GetString("StudentUser")))
    {
        <a href="/TimeTracker" class="btn-utility clock-btn" title="Time Tracker"
            style="text-decoration: none;">
            <i class="fas fa-clock"></i>
        </a>
    }

    <!-- 2. Time Icon (Read-only status) -->
    <div id="themeToggle" class="btn-utility" title="Current Time Theme" style="cursor: default;">
        <i class="fas fa-clock"></i>
    </div>

    <!-- 3. Language Selector -->
    <div class="lang-wrapper" style="position: relative;">
        <!-- Visual Icon (No Click Functionality) -->
        <i class="fas fa-globe text-secondary" style="margin-right: 8px; font-size: 1.1rem;"></i>

        <select class="form-select form-select-sm" id="languageSelector" style="width: auto; cursor: pointer;">
            <option value="en">English</option>
            <option value="es">Español (Spanish)</option>
            <option value="fr">Français (French)</option>
            <option value="de">Deutsch (German)</option>
            <option value="hi">हिन्दी (Hindi)</option>
            <option value="gu">ગુજરાતી (Gujarati)</option>
            <option value="zh">中文 (Chinese)</option>
            <option value="ja">日本語 (Japanese)</option>
            <option value="ru">Русский (Russian)</option>
            <option value="ar">العربية (Arabic)</option>
        </select>
    </div>
</div>

<script>
    (function () {
        // Time-based Theme Logic
        const html = document.documentElement;

        function getThemeByTime() {
            const now = new Date();
            const h = now.getHours();
            const m = now.getMinutes();
            const totalMinutes = h * 60 + m;

            const morningStart = 5 * 60; // 5:00 AM (300)
            const noonStart = 11 * 60 + 31; // 11:31 AM (691)
            const sunsetStart = 17 * 60 + 1; // 5:01 PM (1021)
            const nightStart = 19 * 60 + 1; // 7:01 PM (1141)

            if (totalMinutes >= morningStart && totalMinutes < noonStart) {
                return 'morning';
            } else if (totalMinutes >= noonStart && totalMinutes < sunsetStart) {
                return 'noon';
            } else if (totalMinutes >= sunsetStart && totalMinutes < nightStart) {
                return 'sunset';
            } else {
                // From 19:01 to 23:59 and 00:00 to 04:59
                return 'night';
            }
        }

        function getIconForTheme(theme) {
            switch (theme) {
                case 'morning': return { class: 'fas fa-sun', color: '#FFB300' };
                case 'noon': return { class: 'fas fa-sun', color: '#FF8F00' };
                case 'sunset': return { class: 'fas fa-cloud-sun', color: '#FF5722' };
                case 'night': return { class: 'fas fa-moon', color: '#E0E0E0' };
                default: return { class: 'fas fa-clock', color: 'inherit' };
            }
        }

        function applyTimeBasedTheme() {
            const timeTheme = getThemeByTime();
            const currentTimeTheme = html.getAttribute('data-time-theme');

            if (currentTimeTheme !== timeTheme) {
                html.setAttribute('data-time-theme', timeTheme);

                // Map to base dark/light for backward compatibility with Razor views
                const isLight = timeTheme === 'morning' || timeTheme === 'noon';
                const baseTheme = isLight ? 'light' : 'dark';

                html.setAttribute('data-theme', baseTheme);
                localStorage.setItem('appTheme', baseTheme);

                // Update icon
                const iconContainer = document.getElementById('themeToggle');
                if (iconContainer) {
                    const iconConfig = getIconForTheme(timeTheme);
                    iconContainer.innerHTML = `<i class="${iconConfig.class}" ></i>`;
                }
            }
        }

        // Run on load
        applyTimeBasedTheme();

        // Check every minute (60000ms) to ensure boundary switch is automatic
        setInterval(applyTimeBasedTheme, 60000);

        // Initialize Translator if needed (handled by translator.js usually)
        // Ensure dropdown matches current language
        const savedLang = localStorage.getItem('appLanguage') || 'en';
        const langSelect = document.getElementById('languageSelector');
        if (langSelect) {
            langSelect.value = savedLang;
        }
    })();
</script>

<style>
    /* Ensure utility buttons look good in both contexts */
    .btn-utility {
        padding: 0.5rem;
        border-radius: 50%;
        transition: background-color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
    }

    .btn-utility:hover {
        background-color: rgba(var(--text-primary-rgb), 0.1);
    }
</style>
