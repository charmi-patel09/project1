                    <div class="form-grid">
                        <div class="form-row">
                            <label>From</label>
                            <div class="searchable-select-container" data-id="fromCurrency">
                                <div class="searchable-select-display" onclick="toggleSearchableSelect('fromCurrency')">
                                    <span id="fromCurrencySelected">Loading...</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
