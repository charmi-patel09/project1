                                style="position: absolute; bottom: 12px; right: 12px; border-radius: 8px; width: 32px; height: 32px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                </section>
                }
            

                <!-- Weather Card -->
