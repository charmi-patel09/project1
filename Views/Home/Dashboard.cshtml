                }
            }

            function toggleCustomDaysInput() {
                const type = document.getElementById('newHabitType').value;
                document.getElementById('customDaysInput').style.display = type === 'Custom' ? 'block' : 'none';
            }
            
            // Start polling for reminders
            // ... (rest of your existing polling code)
            let currentPin = "";
            let currentTargetWidget = "";
            
            function openPinModal(widgetId) {
                console.log('[SECURITY] Opening PIN modal for widget:', widgetId);
                currentPin = "";
                currentTargetWidget = widgetId || "";
                
                const pinInput = document.getElementById('realPinInput');
                if (pinInput) {
                    pinInput.value = "";
                    pinInput.disabled = false; // Ensure it's never disabled
                    setTimeout(() => pinInput.focus(), 100);
                    
                    if (!pinInput.dataset.listener) {
                        pinInput.addEventListener('input', (e) => {
                            let val = e.target.value.replace(/\D/g, '').substring(0, 4);
                            e.target.value = val;
                            currentPin = val;
                            updatePinDisplay();
                        });

                        pinInput.addEventListener('keydown', (e) => {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                verifyPin();
                            } else if (e.key === 'Backspace' && currentPin.length > 0) {
                                // Handled by 'input' event, but we can ensure consistency
                                setTimeout(updatePinDisplay, 10);
                            } else if (!/^\d$/.test(e.key) && !['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab', 'Enter'].includes(e.key)) {
                                // Block non-numeric keys at source for better UX
                                e.preventDefault();
                            }
                        });

                        pinInput.addEventListener('paste', (e) => {
                            e.preventDefault();
                            let paste = (e.clipboardData || window.clipboardData).getData('text');
                            let val = paste.replace(/\D/g, '').substring(0, 4);
                            e.target.value = val;
                            currentPin = val;
                            updatePinDisplay();
                        });
                        pinInput.dataset.listener = "true";
                    }
                }

                updatePinDisplay();
                document.getElementById('pinErrorMessage').innerText = "";
                const modal = document.getElementById('pinModal');
                if (modal) {
                    modal.style.display = 'flex';
                }
            }

            function closePinModal() {
                document.getElementById('pinModal').style.display = 'none';
                currentPin = "";
                currentTargetWidget = "";
                const pinInput = document.getElementById('realPinInput');
                if (pinInput) pinInput.value = "";
                updatePinDisplay();
                document.getElementById('pinErrorMessage').innerText = "";
            }

            function pressPinDigit(d) {
                if (currentPin.length < 4) {
                    currentPin += d;
                    const pinInput = document.getElementById('realPinInput');
                    if (pinInput) {
                        pinInput.value = currentPin;
                        pinInput.focus();
                    }
                    updatePinDisplay();
                }
            }

            function clearPin() {
                if (currentPin.length > 0) {
                    currentPin = currentPin.slice(0, -1);
                    const pinInput = document.getElementById('realPinInput');
                    if (pinInput) {
                        pinInput.value = currentPin;
                        pinInput.focus();
                    }
                    updatePinDisplay();
                }
            }

            function updatePinDisplay() {
                const digits = document.querySelectorAll('.pin-digit');
                digits.forEach((el, idx) => {
                    if (idx < currentPin.length) {
                        el.innerHTML = "●";
                        el.classList.add('active');
                    } else {
                        el.innerHTML = "";
                        el.classList.remove('active');
                    }
                });
            }

            async function verifyPin() {
                console.log('[SECURITY] Verifying PIN for:', currentTargetWidget);
                const pinInput = document.getElementById('realPinInput');
                const errorMsg = document.getElementById('pinErrorMessage');
                
                if (currentPin.length < 4) {
                    errorMsg.innerText = "PIN must be 4 digits";
                    return;
                }

                try {
                    const res = await fetch('/Account/VerifyPin', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `pin=${encodeURIComponent(currentPin)}&targetWidget=${encodeURIComponent(currentTargetWidget)}`
                    });
                    
                    if (!res.ok) throw new Error(`HTTP Error: ${res.status}`);
                    
                    const data = await res.json();
                    if (data.success) {
                        sessionStorage.removeItem('PinVerified');
                        sessionStorage.removeItem('isUnlocked');
                        sessionStorage.setItem(`Unlocked_${currentTargetWidget}`, 'true');
                        closePinModal();
                        location.reload(); 
                    } else {
                        errorMsg.innerText = data.message || "Invalid PIN";
                        currentPin = "";
                        if (pinInput) {
                            pinInput.value = "";
                            pinInput.focus(); // Keep keyboard active
                        }
                        updatePinDisplay();
                    }
                } catch (e) {
                    console.error("[SECURITY] Request Error:", e);
                    errorMsg.innerText = "Security service unavailable. Please try again.";
                    if (pinInput) pinInput.focus();
                }
            }

            function showSetupPin() {
                const modal = document.getElementById('setupPinModal');
                if (modal) modal.style.display = 'flex';
            }

            function closeSetupPin() {
                document.getElementById('setupPinModal').style.display = 'none';
            }

            async function saveNewSecurityPin() {
                const pin = document.getElementById('newPinInput').value;
                if (!/^\d{4,6}$/.test(pin)) {
                    document.getElementById('setupPinError').innerText = "PIN must be 4-6 digits";
                    return;
                }

                try {
                    // Reusing a generic API or dedicated one? I'll use a new one in AccountController
                    const formData = new FormData();
                    formData.append('pin', pin);

                    const res = await fetch('/Account/SetupSecurityPin', {
                        method: 'POST',
                        body: formData
                    });
                    
                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        document.getElementById('setupPinError').innerText = data.message || "Failed to save. Try again.";
                    }
                } catch (e) { console.error(e); }
            }

            // Trigger setup pin if needed after small delay only if user just logged in and has no pin
            @if (!IsSecurityEnabled && role != "Admin") {
                @:setTimeout(() => {
                @:    if (!sessionStorage.getItem('setupPromptShown')) {
                @:        showSetupPin();
                @:        sessionStorage.setItem('setupPromptShown', 'true');
                @:    }
                @:}, 1500);
            }
        </script>
        
